{
    "name": "Examen Laravel L3",
    "dockerComposeFile": "docker-compose.yml",
    "service": "app",
    "workspaceFolder": "/workspaces/projet-exam",
    "forwardPorts": [8000],
    "customizations": {
        "vscode": {
            "settings": {
                "chat.disableAIFeatures": true,
                "github.copilot.enable": {
                    "*": false
                },
                "github.copilot.nextEditSuggestions.enabled": false
            }
        }
    }
}